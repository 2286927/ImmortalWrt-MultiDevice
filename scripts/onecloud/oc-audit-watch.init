#!/bin/sh /etc/rc.common
# OneCloud 升级审计实时告警守护（procd 托管，崩溃自动拉起）
START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/lib/oc-audit-watch.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
