#!/bin/sh
#==================================================================================================
# 99-loghygiene —— 首启 / 系统升级后启用并立即执行日志卫生自愈
#
# 作用：
#   1) enable  —— 建立 /etc/rc.d/S99loghygiene（此后每次开机自动执行，持久化到 overlay）
#   2) start   —— 本次启动立即纠正，无需等重启
#
# 幂等：可重复执行；loghygiene 内部无变更时不写 flash。
# 容错：任何一步失败都不影响首启流程（恒定 exit 0）。
#==================================================================================================

[ -x /etc/init.d/loghygiene ] && {
	/etc/init.d/loghygiene enable >/dev/null 2>&1
	/etc/init.d/loghygiene start  >/dev/null 2>&1
}

exit 0
