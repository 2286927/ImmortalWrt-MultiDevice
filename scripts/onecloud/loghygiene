#!/bin/sh /etc/rc.common
#==================================================================================================
# loghygiene —— OneCloud 25.12 出厂固件日志卫生与已知缺陷自愈
#
# 背景：经实机巡检（2026-11-06），出厂固件在无任何用户操作时即持续产生 err/crit 级日志，
#       其中 1 条 Critical（dnsmasq 启动失败）与多条 Error 属系统性缺陷，根因均在出厂模板/
#       包组合，而非用户配置。本脚本在每次开机时幂等校验并纠正，作为配方仓（recipe）模板的
#       兜底，确保即使上游 recipe 未同步修正，新出厂固件也不再复现相同问题。
#
# 处置项（与实机验证报告一一对应）：
#   A9  crond 以 debug 级(5)运行 → 每分钟刷 4~5 行 cron.err，淹没真实错误，挤占 64KB 环形缓冲
#   B5  system.log_proto='udp' 但无 log_ip → 孤儿远程 syslog 残留，削弱本地日志
#   A1  dnsmasq 绑定 docker0(172.17.0.1)，restart 时新旧实例争抢端口 → daemon.crit 启动失败
#   A4  fstab 残留指向已不存在 UUID 的 mount 条目 → 每次开机 block 探测报错
#   A2  avahi-dbus-daemon 已装但 /etc/passwd 无 avahi 用户 → 服务反复崩溃重启(实测 7 次)
#   B2  nfs-kernel-server 启用但 /etc/exports 为空 → NFSD -110 + exportfs 报错，纯空转占内存
#   B6  chronyd 与 sysntpd 同时启用 → 两个 NTP 客户端抢 adjtimex()，chronyd 报
#       "System clock interference detected (another NTP client?)"；保留 sysntpd（system.ntp
#       统一管理 4 个国内源、不对外提供 server），禁用 chronyd
#
# 设计原则：
#   * 幂等：可重复执行，无变更时不写 flash（不 commit、不 reload）
#   * 容错：任一项失败仅记日志，绝不阻塞开机（恒定 exit 0）
#   * 可观测：仅在发生实际变更时通过 logger 落 syslog，避免自身制造噪声
#   * 不越权：只纠正上述已知项，不触碰 DNS 上游、防火墙、AGH/代理等用户业务配置
#==================================================================================================

START=99
EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show current log-hygiene state"

LOG_TAG="loghygiene"
CHANGED=0
RELOAD_DNSMASQ=0

_log() {
	logger -t "$LOG_TAG" "$*" 2>/dev/null
	CHANGED=1
}

# 进程存活判定（供 B6 / status 复用）。
#
# 为什么不用 pgrep：busybox 的 -x 是拿"完整 argv[0]"与给定短名做全等比较，而 chronyd 以
# /usr/sbin/chronyd 启动，用短名 -x 必然落空（QA 实测 rc=1，其实是正确行为，不是故障）；
# 若为绕开它改用 -f，又会把"命令行里含 chronyd 字样"的 shell 自身一并算进来（实机 30450
# 即执行观察命令的 ash）。一个漏判、一个多判，都不能作为存在性判据 —— 此前"两个不同 PID"
# 的假象就是 -f 把调用它的 shell 也算进来所致，设备上真实 chronyd 始终只有 1 个。
#
# 为什么也不能只用 pidof / /proc/<pid>/comm：
#   /etc/rc.common 执行 init 脚本时会 fork 一个子壳，并把它的 comm 设成服务名，实机 ps 可见
#       {chronyd} /bin/sh /etc/rc.common /etc/init.d/chronyd enabled
#   该子壳的 comm 就是 chronyd，于是 pidof 与 /proc/comm 都会误命中。而 B6 自身就要调用
#   `/etc/init.d/chronyd enabled|stop`，任何并发调用都会在 5s 等待期内反复制造这种子壳，
#   造成"进程没停干净"的假告警（实机已出现 `stop 后 5s 仍在运行 (pid N)` 的误报，其中 N
#   极可能就是这种子壳而非 chronyd 本体）。所以 comm 只能用来缩小候选集，不能当结论。
#
# 最终判据：/proc/<pid>/cmdline 的第一个参数的 basename 必须等于 <name>。
# 不写死安装路径：chronyd/ntpd 可能在 /usr/sbin、/sbin 或 /usr/bin（不同固件/包布局），
# 写死 /usr/sbin/ 会在非标准布局上把真实残留判成"干净"，静默跳过 stop 且不写任何日志。
# rc.common 子壳的 cmdline[0] 是 /bin/sh（basename=sh），僵尸 cmdline 为空，据此均被排除。
#
# 判据只认可执行本体：ujail 以 exec 方式拉起真身（非 fork-only 壳），故"仅存在包装层
# 而无本体"在结构上不可能，无需为 ujail 增加例外分支（加了反而会在"包装层存活、本体
# 已死"时制造假阳性）。status 的 ntpd running 可靠，是因为真身 argv[0] 的 basename 为
# ntpd（实测 /usr/sbin/ntpd），而包装层的 /sbin/ujail 被 basename 判据排除 —— 与安装
# 路径无关，勿据此把上面的判定改回硬编码路径。
#
# _proc_pids    ：输出确认为本体的 PID（空格分隔）；无匹配返回 1
# _proc_running ：存活布尔判定（B6 / status 用）
_proc_pids() {
	# 第一段（廉价）：pidof 按 comm 缩候选集；未编译 pidof 的极简 busybox 退化为扫 comm。
	if command -v pidof >/dev/null 2>&1; then
		_cand=$(pidof "$1" 2>/dev/null)
	else
		_cand=""
		for _c_d in /proc/[0-9]*; do
			[ "$(cat "$_c_d/comm" 2>/dev/null)" = "$1" ] && _cand="$_cand ${_c_d#/proc/}"
		done
	fi
	[ -n "$_cand" ] || return 1
	# 第二段（精确）：只对少量候选读 cmdline，排除 comm 被改成服务名的 rc.common 子壳。
	_c_hit=""
	for _c_p in $_cand; do
		_c_a0=$(tr '\0' '\n' < "/proc/$_c_p/cmdline" 2>/dev/null | head -1)
		case "${_c_a0##*/}" in
			"$1") _c_hit="$_c_hit $_c_p" ;;
		esac
	done
	[ -n "$_c_hit" ] || return 1
	echo "${_c_hit# }"
}

_proc_running() {
	_proc_pids "$1" >/dev/null 2>&1
}

start() {
	#------------------------------------------------------------------
	# A9: crond 日志级别 5(debug) → 8(error)
	#------------------------------------------------------------------
	_cur=$(uci -q get system.@system[0].cronloglevel)
	if [ "$_cur" != "8" ]; then
		uci -q set system.@system[0].cronloglevel='8' && _log "A9 cronloglevel ${_cur:-unset} -> 8"
	fi

	#------------------------------------------------------------------
	# B5: 无 log_ip 的孤儿 log_proto
	#------------------------------------------------------------------
	if uci -q get system.@system[0].log_proto >/dev/null 2>&1; then
		_lp=$(uci -q get system.@system[0].log_proto)
		if [ -z "$(uci -q get system.@system[0].log_ip)" ]; then
			uci -q delete system.@system[0].log_proto && _log "B5 removed orphan log_proto (${_lp})"
		fi
	fi

	if [ $CHANGED -eq 1 ]; then
		uci -q commit system
	fi

	#------------------------------------------------------------------
	# A1: dnsmasq 排除 docker0
	#     docker0 由 dockerd 后建，bind-dynamic 需为其额外建 socket；dnsmasq 重启时
	#     新旧实例争抢 172.17.0.1:<port> 触发 daemon.crit "Address in use"。
	#     排除后 dnsmasq 不再持有该地址，竞态窗口消失（实机连续 2 次 restart 验证 crit=0）。
	#------------------------------------------------------------------
	if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
		_ni=$(uci -q get dhcp.@dnsmasq[0].notinterface)
		case " $_ni " in
			*" docker0 "*)
				;;
			*)
				uci -q add_list dhcp.@dnsmasq[0].notinterface='docker0' && {
					uci -q commit dhcp
					RELOAD_DNSMASQ=1
					_log "A1 dhcp notinterface += docker0"
				}
				;;
		esac
	fi

	#------------------------------------------------------------------
	# A4: fstab 中 UUID 已不存在的 mount 条目
	#------------------------------------------------------------------
	if command -v blkid >/dev/null 2>&1 && [ -f /etc/config/fstab ]; then
		_fstab_changed=0
		for _s in $(uci -q show fstab 2>/dev/null | sed -n 's/^fstab\.\([^.=]*\)=mount$/\1/p'); do
			_uuid=$(uci -q get "fstab.$_s.uuid")
			_target=$(uci -q get "fstab.$_s.target")
			[ -z "$_uuid" ] && continue
			if ! blkid -U "$_uuid" >/dev/null 2>&1; then
				uci -q delete "fstab.$_s" && {
					_fstab_changed=1
					_log "A4 removed stale fstab.$_s (target=$_target uuid=$_uuid)"
				}
			fi
		done
		[ $_fstab_changed -eq 1 ] && uci -q commit fstab
	fi

	#------------------------------------------------------------------
	# A2: avahi 运行用户/组缺失
	#     仅当 avahi 包存在且用户缺失时补齐，保留 mDNS 功能（不粗暴禁用）。
	#------------------------------------------------------------------
	if [ -x /etc/init.d/avahi-daemon ] && ! grep -q '^avahi:' /etc/passwd 2>/dev/null; then
		_uid=1000
		while grep -qE ":${_uid}:" /etc/passwd 2>/dev/null; do
			_uid=$((_uid + 1))
			[ $_uid -gt 1100 ] && break
		done
		if [ $_uid -le 1100 ]; then
			echo "avahi:x:${_uid}:${_uid}:avahi:/var/run/avahi:/bin/false" >> /etc/passwd
			grep -q '^avahi:' /etc/group 2>/dev/null || echo "avahi:x:${_uid}:" >> /etc/group
			mkdir -p /var/run/avahi
			chown "avahi:avahi" /var/run/avahi 2>/dev/null
			_log "A2 created avahi user/group (uid=${_uid})"
		fi
	fi

	#------------------------------------------------------------------
	# B2: NFS 已启用但无任何导出 → 纯空转（NFSD -110 / exportfs 报错）
	#------------------------------------------------------------------
	if [ -x /etc/init.d/nfs ]; then
		_exportcnt=$(grep -cvE '^[[:space:]]*#|^[[:space:]]*$' /etc/exports 2>/dev/null)
		[ -z "$_exportcnt" ] && _exportcnt=0
		if [ "$_exportcnt" -eq 0 ] 2>/dev/null; then
			if /etc/init.d/nfs enabled >/dev/null 2>&1; then
				/etc/init.d/nfs disable >/dev/null 2>&1 && _log "B2 nfs disabled (no exports)"
			fi
			/etc/init.d/nfs stop >/dev/null 2>&1
		fi
	fi

	#------------------------------------------------------------------
	# B6: chronyd 与 sysntpd 同时启用
	#     sysntpd 由 base-files 依 system.ntp 段自动生成（S98sysntpd），chrony 是额外装入的
	#     包（feeds/packages/net/chrony，S15 启动）—— 两个 NTP 客户端各自 adjtimex()，
	#     chronyd 触发 daemon.warn "System clock interference detected (another NTP client?)"。
	#     业务决策：保留 sysntpd 作为唯一 NTP 客户端 —— 由 uci system.ntp 统一管理 4 个国内
	#     源，且不对外提供 NTP server（enable_server=0，此时 sysntpd 不加 -l 参数、不监听
	#     123 端口，避免公网 IPv6 暴露）。既然 sysntpd 已能满足需求，chronyd 属重复实现，
	#     故禁用 chronyd。
	#     仅在 sysntpd 确实启用时才动 chronyd，避免把用户唯一的时间同步手段关掉。
	#
	#     注：此处不修正 system.ntp 的 enable_server —— 那属"是否对外提供 NTP 服务"的业务
	#     决策，已由出厂 system 模板与构建期断言固定为 '0'；自愈脚本不重复接管，以免
	#     与模板/构建流水线产生配置漂移。
	#------------------------------------------------------------------
	if [ -x /etc/init.d/chronyd ] && [ -x /etc/init.d/sysntpd ]; then
		if /etc/init.d/sysntpd enabled >/dev/null 2>&1; then
			_b6_cfg=""
			_b6_rsd=0
			if /etc/init.d/chronyd enabled >/dev/null 2>&1; then
				if /etc/init.d/chronyd disable >/dev/null 2>&1; then
					_b6_cfg="disabled"
				else
					# disable 失败（overlay 只读 / init 脚本异常）：不谎报成功，只记录事实。
					# 但进程残留比 rc.d 链接更要紧，下一步仍照常 stop 止血。
					_b6_cfg="disable-failed"
				fi
			elif _proc_running chronyd; then
				# chronyd 已 disable 但进程残留（手工启动 / 上一轮未停净）
				_b6_rsd=1
			fi
			if [ -n "$_b6_cfg" ] || [ $_b6_rsd -eq 1 ]; then
				/etc/init.d/chronyd stop >/dev/null 2>&1
				# chronyd 由 procd 托管，term 到进程真正退出有 1~3s 延迟；
				# 不等它退净就返回，chronyd 仍会再报一次 interference。故此处等待确认。
				_b6_w=0
				while _proc_running chronyd && [ $_b6_w -lt 5 ]; do
					sleep 1
					_b6_w=$((_b6_w + 1))
				done
				# 日志据实而言：动作标识只在 stop 确认成功后才含 "stopped"，否则会输出
				# "disabled+stopped 但仍在运行" 这类自相矛盾的谎言（Round2 修复）。
				if _proc_running chronyd; then
					# 用 _proc_pids 而非 pidof：日志里的 PID 必须是已确认的本体，
					# 否则会把 rc.common 子壳的 PID 写进告警，把人引到错误方向。
					_b6_pid=$(_proc_pids chronyd 2>/dev/null)
					case "$_b6_cfg" in
						disabled)	_b6_what="已 disable" ;;
						disable-failed)	_b6_what="disable 失败" ;;
						*)		_b6_what="本就已 disable" ;;
					esac
					logger -t "$LOG_TAG" -p user.warn \
						"B6 chronyd ${_b6_what}，stop 后 5s 仍在运行${_b6_pid:+ (pid $_b6_pid)}"
				elif [ "$_b6_cfg" = "disable-failed" ]; then
					logger -t "$LOG_TAG" -p user.warn \
						"B6 chronyd disable 失败（进程已 stop），下次开机仍会自启"
				elif [ $_b6_rsd -eq 1 ]; then
					_log "B6 chronyd stopped residual chronyd (sysntpd 已启用，避免双 NTP 抢时钟)"
				else
					_log "B6 chronyd disabled+stopped (sysntpd 已启用，避免双 NTP 抢时钟)"
				fi
			fi
		fi
	fi

	#------------------------------------------------------------------
	# 变更后按需重载（仅当本轮确实改了配置）
	#------------------------------------------------------------------
	if [ $RELOAD_DNSMASQ -eq 1 ]; then
		/etc/init.d/dnsmasq reload >/dev/null 2>&1 || \
			/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi

	return 0
}

# 供手工排障调用：/etc/init.d/loghygiene status
status() {
	echo "cronloglevel : $(uci -q get system.@system[0].cronloglevel)"
	echo "log_proto    : $(uci -q get system.@system[0].log_proto || echo '(unset)')"
	echo "dnsmasq notif: $(uci -q get dhcp.@dnsmasq[0].notinterface || echo '(unset)')"
	echo "avahi user   : $(grep -c '^avahi:' /etc/passwd 2>/dev/null || echo 0)"
	echo "nfs enabled  : $(/etc/init.d/nfs enabled >/dev/null 2>&1 && echo yes || echo no)"
	echo "chronyd      : $(/etc/init.d/chronyd enabled >/dev/null 2>&1 && echo enabled || echo disabled)"
	echo "sysntpd      : $(/etc/init.d/sysntpd enabled >/dev/null 2>&1 && echo enabled || echo disabled)"
	echo "ntpd running : $(_proc_running ntpd && echo yes || echo no)"
	echo "chronyd running: $(_proc_running chronyd && echo yes || echo no)"
	echo "enable_server: $(uci -q get system.ntp.enable_server)"
	echo "ntp :123     : $(netstat -lnup 2>/dev/null | grep -q ':123 ' && echo 'listening' || echo 'not listening')"
}
