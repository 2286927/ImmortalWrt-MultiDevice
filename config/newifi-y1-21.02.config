# ============================================================
# ImmortalWrt 21.02 · newifi Y1（mt7620a）专用配置
# 对齐 23.05 软件包：zerotier / ddns(dnspod拆包) / socat / USB打印链
# 裁剪：防火墙界面 / Argon主题 / TurboACC / 网络诊断
# 说明：21.02 为 iptables 时代（防火墙服务 firewall，非 firewall4）；
#       21.02 与 23.05 同为 ddns-scripts 拆包体系（ddns-scripts-dnspod 存在）
# ============================================================

# ---- 目标设备 ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_lenovo_newifi-y1=y

# ---- LuCI（21.02 lua 版，luci-mod-admin-full 聚合）----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ---- 中文语言包 ----
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- 组网：zerotier ----
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ---- DDNS（21.02 已拆包，仅腾讯云 dnspod）----
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ---- SOCAT ----
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-app-socat=y
CONFIG_PACKAGE_luci-i18n-socat-zh-cn=y

# ---- USB 打印链（usbip 拆分子包：common=库 / client=usbip 命令 / server=usbipd）----
CONFIG_PACKAGE_luci-app-usb-printer=y
CONFIG_PACKAGE_luci-i18n-usb-printer-zh-cn=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_usbip=y
CONFIG_PACKAGE_kmod-usbip=y
CONFIG_PACKAGE_usbip-client=y
CONFIG_PACKAGE_usbip-server=y
CONFIG_PACKAGE_kmod-usbip-client=y
CONFIG_PACKAGE_kmod-usbip-server=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_libusb-1.0=y

# ---- 系统增强 ----
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y

# ---- 核心服务（保障完整）----
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_kmod-mt76x2=y

# ---- 裁剪：防火墙界面 / Argon / TurboACC / 网络诊断 ----
# CONFIG_PACKAGE_luci-app-firewall is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-diagnostics is not set
