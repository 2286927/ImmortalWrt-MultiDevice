# 禁用 Rust
CONFIG_LANG_RUST=n
CONFIG_PACKAGE_rust=n
CONFIG_PACKAGE_rust-std=n
CONFIG_PACKAGE_rustc=n
CONFIG_PACKAGE_cargo=n
CONFIG_PACKAGE_sing-box=n
CONFIG_PACKAGE_alist=n
CONFIG_PACKAGE_fd=n
CONFIG_PACKAGE_ripgrep=n
CONFIG_PACKAGE_btop=n
CONFIG_PACKAGE_zellij=n
CONFIG_PACKAGE_starship=n
CONFIG_PACKAGE_exa=n
CONFIG_PACKAGE_bat=n
CONFIG_PACKAGE_bottom=n
CONFIG_PACKAGE_helix=n
CONFIG_PACKAGE_atuin=n
CONFIG_PACKAGE_librust=n
# 2026-11-14: passwall 的两个 Rust 组件会拉起 rust/host（该 host 包在 package 阶段编译失败）
# 与 luci-app-dns-switch 无关；禁用后 r68s 固件不含 Shadowsocks-Rust 客户端/服务端
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
